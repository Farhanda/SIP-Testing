# ============================================
#  Konfigurasi Environment Automation UI Test
#  Copy file ini menjadi ".env" lalu sesuaikan
# ============================================

# ----- Aplikasi target -----
# Pilih environment aplikasi FE yang diuji dengan UI_ENV (dev/staging/prod):
#   dev     → http://10.200.101.13:3000   (hanya bisa dari wifi kantor)
#   staging → http://10.200.101.6:3000    (hanya bisa dari wifi kantor)
#   prod    → https://sip.c2signals.com   (bisa diakses di mana saja)
# Contoh: UI_ENV=staging
# UI_ENV=dev
#
# Atau set URL langsung via CLI (env var CLI selalu menang atas isi .env):
# BASE_URL_UI=http://localhost:3000

# ----- Mode eksekusi -----
# UI_HEADED=1   → jalankan dengan browser terlihat (debug)

# ----- Kredensial user test (login UI, auth asli) -----
# Dipakai oleh setup auth (storageState) & test case login.
# WAJIB diisi — tidak ada default di kode (secret tidak boleh ter-commit).
UI_TEST_USERNAME=admin
UI_TEST_PASSWORD=ubah-dengan-password-test

# ----- Kredensial client (role terbatas: hanya home & display wall) -----
# Dipakai oleh setup auth client (.auth/fe-client-state.json) & test client.
UI_CLIENT_USERNAME=client
UI_CLIENT_PASSWORD=ubah-dengan-password-client

# ----- Password akun admin saat ini (regression change-password P05) -----
# Dipakai tests/fe/profile/regression-bugs.spec.ts sebagai current password benar.
UI_ADMIN_CURRENT_PASSWORD=ubah-dengan-password-admin-saat-ini

# ----- Mode eksekusi -----

# UI_HEADED=0   → headless (default, untuk CI)
# UI_HEADED=

# Browser yang dipakai, pisahkan dengan koma bila ingin cross-browser:
#   chromium (default) | firefox | webkit
# Contoh cross-browser: UI_BROWSERS=chromium,firefox,webkit
# UI_BROWSERS=chromium

# Opsional: pakai Google Chrome yang ter-install di sistem (tidak perlu
# `npx playwright install`), misal: UI_BROWSER_CHANNEL=chrome
# UI_BROWSER_CHANNEL=

# ----- Timeout -----
# UI_TIMEOUT=15000

# ----- API Backend (testing platform BE & AI) -----
# Base URL API backend target (BE lokal)
# BASE_URL_BE=http://localhost:8080

# Scrape service / api-gateway (keyword-management, credential, platform)
# BASE_URL_SCRAPE=http://10.200.101.13:8080

# Prefiks versi API backend (default /v1)
# BE_API_PREFIX=/v1

# ----- AI Service (SIP AI Service, platform AI) -----
# Base URL service AI (docs: http://10.200.102.2:8100/docs)
# BASE_URL_AI=http://10.200.102.2:8100

# Token service AI — header X-Service-Token (dev lokal: dev-local-service-token)
# AI_SERVICE_TOKEN=dev-local-service-token

# ----- Scraper service RAW (backend BE kedua, port 8090) -----
# Backend BE: dashboard-service (BASE_URL_BE) + scraper service langsung
# (tanpa prefix /scrape/ — beda dari api-gateway BASE_URL_SCRAPE)
# BASE_URL_SCRAPER=http://10.200.101.13:8090

# ----- Intelligence AI Service (service AI kedua, port 8000) -----
# Docs: http://10.200.102.2:8000/docs — header auth X-AI-Service-Token
# BASE_URL_AI_INTELLIGENCE=http://10.200.102.2:8000
# AI_INTELLIGENCE_TOKEN=<token per-service dari tim AI>

# ----- Kolom eksekusi di Excel test case (npm run test-cases) -----
# Environment: "Dev" / "Staging" / "Production" (default otomatis dari URL:
# 10.200.101.13 → Dev, 10.200.101.6 → Staging, sip.c2signals.com → Production)
# TEST_ENV=Staging

# Executed By: nama eksekutor test (default: "—")
# TEST_EXECUTED_BY=
