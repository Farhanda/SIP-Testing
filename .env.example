# ============================================
#  Konfigurasi Environment Automation UI Test
#  Copy file ini menjadi ".env" lalu sesuaikan
# ============================================

# ----- Aplikasi target -----
# Base URL aplikasi web yang diuji (Next.js SIP Insight)
BASE_URL_UI=http://localhost:3000

# ----- Mode eksekusi -----
# UI_HEADED=1   → jalankan dengan browser terlihat (debug)
# UI_HEADED=0   → headless (default, untuk CI)
# UI_HEADED=

# Browser yang dipakai, pisahkan dengan koma bila ingin cross-browser:
#   chromium (default) | firefox | webkit
# Contoh cross-browser: UI_BROWSERS=chromium,firefox,webkit
# UI_BROWSERS=chromium

# Opsional: pakai Google Chrome yang ter-install di sistem (tidak perlu
# `npx playwright install`), misal: UI_BROWSER_CHANNEL=chrome
# UI_BROWSER_CHANNEL=

# ----- Timeout -----
# UI_TIMEOUT=15000

# ----- API Backend (testing platform BE & AI) -----
# Base URL API backend target (BE lokal)
# BASE_URL_BE=http://localhost:8080

# Scrape service / api-gateway (keyword-management, credential, platform)
# BASE_URL_SCRAPE=http://10.200.101.13:8080

# Prefiks versi API backend (default /v1)
# BE_API_PREFIX=/v1

# ----- AI Service (SIP AI Service, platform AI) -----
# Base URL service AI (docs: http://10.200.102.2:8100/docs)
# BASE_URL_AI=http://10.200.102.2:8100

# Token service AI — header X-Service-Token (dev lokal: dev-local-service-token)
# AI_SERVICE_TOKEN=dev-local-service-token

# ----- Kolom eksekusi di Excel test case (npm run test-cases) -----
# Environment: "Local" / "Staging" / "Production" (default: Local bila
# BASE_URL_UI localhost, selain itu Staging)
# TEST_ENV=Local

# Executed By: nama eksekutor test (default: "—")
# TEST_EXECUTED_BY=
